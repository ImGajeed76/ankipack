{
  "name": "ankipack",
  "version": "0.2.0",
  "description": "Generate, read and edit Anki .apkg decks with full FSRS support. Works in browsers, Node.js, and Bun.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --sourceMap false --declarationMap false",
    "check": "tsc -p tsconfig.check.json",
    "e2e:setup": "./e2e/setup.sh",
    "format": "bunx prettier --write src/ test/ e2e/",
    "format:check": "bunx prettier --check src/ test/ e2e/",
    "generate": "bunx buf generate",
    "lint": "bunx eslint src/ test/ e2e/",
    "prepublishOnly": "bun run check && bun run lint && bun run format:check && bun run build && bun run test",
    "test": "bun test ./test",
    "test:e2e": "bun test ./e2e"
  },
  "keywords": [
    "anki",
    "apkg",
    "flashcards",
    "spaced-repetition",
    "fsrs",
    "deck-generator",
    "apkg-reader",
    "anki-deck",
    "srs"
  ],
  "author": "Oliver Seifert",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImGajeed76/ankipack.git"
  },
  "homepage": "https://github.com/ImGajeed76/ankipack",
  "bugs": {
    "url": "https://github.com/ImGajeed76/ankipack/issues"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "fflate": "^0.8.2",
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.50.0",
    "@bufbuild/protoc-gen-es": "^2.6.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.12",
    "@types/sql.js": "^1.4.9",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "sql.js": "^1.12.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.2"
  },
  "peerDependencies": {
    "sql.js": "^1.12.0"
  },
  "peerDependenciesMeta": {
    "sql.js": {
      "optional": true
    }
  }
}
